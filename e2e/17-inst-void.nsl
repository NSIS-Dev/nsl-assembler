/*
 * Instructions that take arguments and return nothing.
 *
 * Grouped by shape rather than by subject, because the bugs these catch are
 * about arity and operand order, and those do not respect subject boundaries.
 * The registry, filesystem and UI families get their own files.
 */

#include "guard.nsl"

Name("17 inst void");
OutFile("17-inst-void.exe");

section Test("void instructions")
{
  // Detail window.
  DetailPrint("void: DetailPrint");
  SetDetailsPrint("both");
  SetDetailsView("show");
  SetAutoClose("false");

  // The error flag.
  ClearErrors();
  SetErrors();
  ClearErrors();

  // Error level returned by the installer process.
  SetErrorLevel(0);

  // Reboot flag.
  SetRebootFlag(false);

  // Silent flag.
  SetSilent("normal");

  // Which of $SMPROGRAMS, $DESKTOP etc. resolve per-user or per-machine.
  SetShellVarContext("current");
  SetShellVarContext("all");
  SetShellVarContext("current");

  // Registry view on 64-bit Windows.
  SetRegView("32");
  SetRegView("64");
  SetRegView("default");

  // Overwrite policy for File(), scoped to the rest of the section.
  SetOverwrite("try");
  SetOverwrite("on");

  // Compression, which is legal inside a section as well as globally.
  SetCompress("off");
  SetCompress("auto");

  // The plugins directory, needed before any plugin call.
  InitPluginsDir();

  // Plugin unload policy. makensis calls this deprecated - a plugin is meant to
  // manage its own unloading - but still compiles both modes.
  SetPluginUnload("alwaysoff");
  SetPluginUnload("manual");

  // Does nothing, so the only thing to get wrong is emitting an operand.
  Nop();

  // The stack. Exch takes no operand to swap the top two items, a variable to
  // swap with the top one, or an index to swap the top with that item.
  Push("pushed");
  Push("pushed second");
  Exch();
  $R1 = "swapped in";
  Exch($R1);
  Exch(1);
  $R0 = Pop();
  DetailPrint("void: popped ".$R0);
  $R0 = Pop();
  DetailPrint("void: popped ".$R0);

  // Sleep, with a literal and with an operand that has to be assembled first.
  Sleep(10);
  $R2 = 5;
  Sleep($R2 * 2);

  // Install type selection.
  SetCurInstType(0);

  /*
   * Not covered: LogSet and LogText. Both need an NSIS built with
   * NSIS_CONFIG_LOG, which the stock build is not, and makensis rejects the
   * script outright rather than warning - so covering them would mean the whole
   * corpus only runs against a special build.
   */

  /*
   * ChangeUI is a global-scope attribute and lives in 16-attributes.nsl. The
   * address family - Call, GetCurrentAddress, GetFunctionAddress and
   * GetLabelAddress - is in 06-functions.nsl, next to the calling convention
   * they exist to work around.
   */
}
